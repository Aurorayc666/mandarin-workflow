# Copy this file to .env and fill in your values.
# The .env file is loaded automatically by all scripts — no need to set env vars manually.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Azure app registration "Application (client) ID" (public/desktop client).
MS_CLIENT_ID=

# Recipient address for the recap draft (visible To field). Required by generate_next_class_plan.py.
RECAP_TO=

# Optional comma-separated BCC recipients. Used by generate_next_class_plan.py only.
RECAP_BCC=

# OneNote notebook name (default shown).
NOTEBOOK_NAME=Mandarin_Class

# Target section where generate_next_class_plan.py saves new class plans.
LESSON_PLAN_SECTION=Summer 2026 Class Plans

# Section name used by generate_handouts.py to read completed lesson plans.
SUMMER_SECTION=Summer 2026 Class Plans
