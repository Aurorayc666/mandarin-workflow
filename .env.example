# Copy to a method of your choice and set these before running the scripts.
# In PowerShell (current session):
#   $env:GEMINI_API_KEY = "..."
# Persistent (new terminals):
#   setx GEMINI_API_KEY "..."

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Azure app registration "Application (client) ID" (public/desktop client).
MS_CLIENT_ID=

# Recipient address for the recap draft (visible To field). Required by manage_class.py only.
RECAP_TO=

# Optional comma-separated BCC recipients. Used by manage_class.py only.
RECAP_BCC=

# OneNote notebook name (default shown).
NOTEBOOK_NAME=Mandarin_Class

# Section containing the completed semester's class plans.
# Used by generate_handouts.py and plan_semester.py (default shown).
SPRING_SECTION=Spring 2026 Class Plans
