# Copy to a method of your choice and set these before running manage_class.py.
# In PowerShell (current session):
#   $env:GEMINI_API_KEY = "..."
# Persistent (new terminals):
#   setx GEMINI_API_KEY "..."

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Azure app registration "Application (client) ID" (public/desktop client).
MS_CLIENT_ID=

# Recipient address for the recap draft (visible To field).
RECAP_TO=

# Optional comma-separated BCC recipients.
RECAP_BCC=

# Optional: OneNote notebook to read past lesson plans from (default "Mandarin").
NOTEBOOK_NAME=Mandarin
